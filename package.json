{
  "name": "nextjs",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npm-run-all --parallel dev:*",
    "dev:next": "TZ=Etc/UTC next dev --port 1337",
    "dev:graphql": "bun run codegen -- --watch",
    "build": "npm run build:graphql && npm run build:next",
    "build:next": "next build",
    "build:graphql": "bun run codegen",
    "start": "next start",
    "static:lint": "eslint .",
    "static:types": "tsc --noEmit",
    "static": "npm-run-all --parallel static:*",
    "dump-prod": "mongodump --excludeCollection=kilterboard_climbs  --excludeCollection=kilterboard_climb_stats --excludeCollection=toplogger_graphql --uri=\"$(npx --yes dotenv-cli -e .env.local -- bash -c 'echo $PROD_MONGODB_URL')\" --out=\"mongodump/$(date '+%Y-%m-%d-%H:%M:%S')\"",
    "restore-local-from-dump": "mongorestore -h 127.0.0.1 --port 27017 --drop --nsFrom=\"self.*\" --nsTo=\"test.*\"",
    "copy-prod": "npm run dump-prod && npm run restore-local-from-dump mongodump/$(ls -Art mongodump | tail -n 1)",
    "codegen": "graphql-codegen --config codegen.ts"
  },
  "dependencies": {
    "@apollo/client": "^4.2.12",
    "@apollo/client-integration-nextjs": "^0.14.5",
    "@apollo/server": "^5.5.1",
    "@as-integrations/next": "^4.1.0",
    "@auth/mongodb-adapter": "3.11.3",
    "@date-fns/tz": "^1.5.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@eslint/js": "^10.0.1",
    "@fortawesome/fontawesome-svg-core": "^7.3.1",
    "@fortawesome/free-regular-svg-icons": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@fortawesome/react-fontawesome": "^3.5.0",
    "@googleapis/gmail": "^18.0.0",
    "@graphql-codegen/cli": "^7.2.0",
    "@graphql-codegen/typed-document-node": "^7.1.0",
    "@graphql-codegen/typescript": "^6.1.0",
    "@graphql-codegen/typescript-resolvers": "^6.1.0",
    "@graphql-tools/schema": "^10.1.0",
    "@nivo/line": "^0.99.0",
    "@parcel/watcher": "^2.6.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/lodash": "^4.17.25",
    "@types/uuid": "^10.0.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/functions": "^3.9.3",
    "ably": "^2.27.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "cheerio": "^1.2.0",
    "date-fns": "^4.4.0",
    "echarts-for-react": "^3.0.6",
    "eslint-config-next": "^16.3.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "google-auth-library": "10.5.0",
    "graphql": "^17.0.2",
    "graphql-tag": "^2.12.7",
    "graphql-type-json": "^0.3.2",
    "ical-generator": "^11.1.0",
    "jsonwebtoken": "^9.0.3",
    "lodash": "^4.18.1",
    "lodash.debounce": "^4.0.8",
    "luxon": "^3.7.2",
    "mongodb": "^7.5.0",
    "next": "^16.3.1",
    "next-auth": "^5.0.0-beta.31",
    "npm-run-all": "^4.1.5",
    "partysocket": "1.3.0",
    "postcss": "^8.5.26",
    "react": "^19.2.8",
    "react-apollo-network-status": "^7.0.0",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.85.0",
    "react-markdown": "^10.1.0",
    "react-select": "^5.10.2",
    "remark-gfm": "^4.0.1",
    "rrule": "^2.8.1",
    "sharp": "^0.35.3",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "typescript-eslint": "^8.67.0",
    "uuid": "^14.0.2",
    "zod": "^4.4.3",
    "zod-defaults": "^0.2.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@serwist/turbopack": "^9.5.12",
    "@types/bun": "^1.3.14",
    "@types/luxon": "^3.7.4",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "dayjs": "^1.11.23",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.4",
    "partykit": "0.0.115",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "serwist": "^9.5.12",
    "typescript": "^7.0.2"
  },
  "trustedDependencies": [
    "@apollo/protobufjs",
    "@parcel/watcher",
    "@swc/core",
    "@tailwindcss/oxide",
    "esbuild",
    "sharp",
    "workerd"
  ]
